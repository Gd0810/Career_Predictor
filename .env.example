# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (defaults to SQLite if left blank). Fill these in to use MySQL instead.
USE_MYSQL=False
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# NVIDIA AI Build (https://build.nvidia.com/models) - 4 accounts / 4 model API keys
# Assign one key per AI feature. If a key is left blank, the feature automatically
# falls back to a rule-based/offline result so the app keeps working.
NVIDIA_API_KEY_RESUME_PARSER=
NVIDIA_API_KEY_CAREER_ROADMAP=
NVIDIA_API_KEY_RESUME_ANALYZER=
NVIDIA_API_KEY_CHAT=

NVIDIA_MODEL_RESUME_PARSER=
NVIDIA_MODEL_CAREER_ROADMAP=
NVIDIA_MODEL_RESUME_ANALYZER=
NVIDIA_MODEL_CHAT=

NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
